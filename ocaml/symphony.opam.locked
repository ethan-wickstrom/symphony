opam-version: "2.0"
name: "symphony"
version: "0.1.0"
synopsis: "A reference Symphony implementation with checked boundaries"
maintainer: "Ethan Wickstrom"
authors: "Ethan Wickstrom"
license: "Apache-2.0"
homepage: "https://github.com/ethan-wickstrom/symphony"
bug-reports: "https://github.com/ethan-wickstrom/symphony/issues"
depends: [
  "afl-persistent" {= "1.4" & with-test}
  "alcotest" {= "1.9.1" & with-test}
  "angstrom" {= "0.16.1"}
  "asn1-combinators" {= "0.3.3"}
  "astring" {= "0.8.5"}
  "base" {= "v0.17.3" & with-dev-setup}
  "base-bigarray" {= "base"}
  "base-domains" {= "base"}
  "base-effects" {= "base"}
  "base-nnp" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "base64" {= "3.5.2"}
  "bigstringaf" {= "0.10.0"}
  "bos" {= "0.3.0"}
  "bstr" {= "0.1.1"}
  "camlp-streams" {= "5.0.1" & with-dev-setup}
  "cmdliner" {= "2.1.1"}
  "conf-gmp" {= "5"}
  "conf-gmp-powm-sec" {= "4"}
  "conf-pkg-config" {= "5"}
  "cppo" {= "1.8.0"}
  "crowbar" {= "0.2.2" & with-test}
  "csexp" {= "1.5.2"}
  "cstruct" {= "6.3.0"}
  "ctypes" {= "0.24.0"}
  "digestif" {= "1.3.1"}
  "domain-local-await" {= "1.0.1"}
  "domain-name" {= "0.5.0"}
  "dune" {= "3.24.0"}
  "dune-build-info" {= "3.24.2" & with-dev-setup}
  "dune-configurator" {= "3.24.2"}
  "duration" {= "0.3.1"}
  "eio" {= "1.6"}
  "eio_posix" {= "1.6"}
  "either" {= "1.0.0" & with-dev-setup}
  "eqaf" {= "0.10"}
  "faraday" {= "0.8.2"}
  "fix" {= "20250919" & with-dev-setup}
  "fmt" {= "0.11.0"}
  "fpath" {= "0.7.3"}
  "gmap" {= "0.3.0"}
  "h1" {= "1.1.1"}
  "hmap" {= "0.8.1"}
  "httpun-types" {= "0.2.0"}
  "integers" {= "0.8.0"}
  "iomux" {= "0.4"}
  "ipaddr" {= "5.6.2"}
  "jingoo" {= "1.5.4"}
  "kdf" {= "1.1.2"}
  "logs" {= "0.10.0"}
  "lwt-dllist" {= "1.1.0"}
  "macaddr" {= "5.6.2"}
  "menhir" {= "20260209"}
  "menhirCST" {= "20260209"}
  "menhirGLR" {= "20260209"}
  "menhirLib" {= "20260209"}
  "menhirSdk" {= "20260209"}
  "mirage-crypto" {= "1.2.0"}
  "mirage-crypto-ec" {= "1.2.0"}
  "mirage-crypto-pk" {= "1.2.0"}
  "mirage-crypto-rng" {= "1.2.0"}
  "mtime" {= "2.2.0"}
  "ocaml" {= "5.5.0"}
  "ocaml-base-compiler" {= "5.5.0"}
  "ocaml-compiler" {= "5.5.0"}
  "ocaml-compiler-libs" {= "v0.17.0"}
  "ocaml-options-vanilla" {= "1"}
  "ocaml-syntax-shims" {= "1.0.0"}
  "ocaml-version" {= "4.1.4" & with-dev-setup}
  "ocaml_intrinsics_kernel" {= "v0.17.2" & with-dev-setup}
  "ocamlbuild" {= "0.16.1"}
  "ocamlfind" {= "1.9.9~preview"}
  "ocamlformat" {= "0.28.1" & with-dev-setup}
  "ocamlformat-lib" {= "0.28.1" & with-dev-setup}
  "ocp-indent" {= "1.10.0" & with-dev-setup}
  "ohex" {= "0.2.0"}
  "optint" {= "0.3.0"}
  "ppx_derivers" {= "1.2.1"}
  "ppx_deriving" {= "6.2.0"}
  "ppxlib" {= "0.38.0"}
  "psq" {= "0.2.1"}
  "ptime" {= "1.2.0"}
  "qcheck-core" {= "0.91" & with-test}
  "re" {= "1.14.0"}
  "rresult" {= "0.7.0"}
  "seq" {= "base"}
  "sexplib0" {= "v0.17.0"}
  "stdio" {= "v0.17.0" & with-dev-setup}
  "stdlib-shims" {= "0.3.0"}
  "stringext" {= "1.6.0"}
  "thread-table" {= "1.0.0"}
  "tls" {= "2.1.3"}
  "tls-eio" {= "2.1.3"}
  "topkg" {= "1.1.1"}
  "uri" {= "4.4.0"}
  "uucp" {= "17.0.0"}
  "uuseg" {= "17.0.0" & with-dev-setup}
  "uutf" {= "1.0.4"}
  "x509" {= "1.2.0"}
  "yaml" {= "3.2.0"}
  "yojson" {= "3.0.0"}
  "zarith" {= "1.14"}
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
  ["dune" "runtest" "-p" name "-j" jobs] {with-test}
]
