export PATH := justfile_directory() + "/../conformance/.venv/bin:" + env_var("PATH")

conformance-env:
    python3 -m venv ../conformance/.venv
    ../conformance/.venv/bin/python -m pip install --require-hashes --only-binary=:all: --no-cache-dir --disable-pip-version-check -r ../conformance/requirements.lock
    ../conformance/.venv/bin/python -m pip install --no-build-isolation --no-deps --disable-pip-version-check ../conformance

build: conformance-env
    opam exec --switch . -- dune build @all @test/native-http-inputs

test: build
    opam exec --switch . -- dune runtest
    python3 test/native_check_test.py
    PYTHONOPTIMIZE=1 python3 test/native_check_test.py
    python3 test/native_check.py --kernel _build/default/test/native_kernel/test_main.exe --host _build/default/test/native_host/test_main.exe --http _build/default/test/native_http_test.exe --agent _build/default/test/native_agent_test.exe --lifecycle _build/default/test/host_lifecycle_main.exe --out _build/native-evidence
    PYTHONOPTIMIZE=1 python3 test/native_check.py --kernel _build/default/test/native_kernel/test_main.exe --host _build/default/test/native_host/test_main.exe --http _build/default/test/native_http_test.exe --agent _build/default/test/native_agent_test.exe --lifecycle _build/default/test/host_lifecycle_main.exe --out _build/native-evidence-optimized
    python3 test/cli_check.py _build/default/bin/main.exe
    PYTHONOPTIMIZE=1 python3 test/cli_check.py _build/default/bin/main.exe
    python3 test/tracker_cli_check.py _build/default/bin/main.exe
    PYTHONOPTIMIZE=1 python3 test/tracker_cli_check.py _build/default/bin/main.exe
    just service-cli
    just status-cli

service-cli: build
    #!/usr/bin/env bash
    set -euo pipefail
    evidence="$(mktemp -d "$PWD/_build/service-cli-XXXXXX")"
    python3 test/service_process_test.py -v
    python3 -O test/service_process_test.py -v
    python3 test/service_cli_check.py _build/default/bin/main.exe --out "$evidence/normal"
    PYTHONOPTIMIZE=1 python3 test/service_cli_check.py _build/default/bin/main.exe --out "$evidence/optimized"
    printf '%s\n' "$evidence"

status-cli: build
    #!/usr/bin/env bash
    set -euo pipefail
    evidence="$(mktemp -d "$PWD/_build/status-cli-XXXXXX")"
    python3 test/status_cli_check.py _build/default/bin/main.exe --out "$evidence/normal"
    PYTHONOPTIMIZE=1 python3 test/status_cli_check.py _build/default/bin/main.exe --out "$evidence/optimized"
    printf '%s\n' "$evidence"

format:
    opam exec --switch . -- dune fmt

check-format:
    opam exec --switch . -- dune build @fmt

check: test check-format
    just conformance
    just capacity
    just protocol-codec
    opam exec --switch . -- python3 test/lifecycle_types_test.py
    opam exec --switch . -- python3 -O test/lifecycle_types_test.py
    opam exec --switch . -- dune exec tools/check_source.exe -- .
    opam exec --switch . -- dune exec tools/check_source.exe -- --self-test
    python3 tools/check_protocol.py .
    PYTHONOPTIMIZE=1 python3 tools/check_protocol.py .
    python3 test/verification_check.py .
    python3 tools/check_h1.py ../vendor/h1
    PYTHONOPTIMIZE=1 python3 tools/check_h1.py ../vendor/h1
    just release-tools

protocol-codec: build
    opam exec --switch . -- dune exec test/protocol_fixtures.exe > _build/codec-fixtures.jsonl
    python3 tools/protocol_codec_check.py _build/codec-fixtures.jsonl --exporter _build/default/test/protocol_fixtures.exe --evidence-dir _build/codec-evidence/normal
    python3 -O tools/protocol_codec_check.py _build/codec-fixtures.jsonl --exporter _build/default/test/protocol_fixtures.exe --evidence-dir _build/codec-evidence/optimized

capacity: build
    #!/usr/bin/env bash
    set -euo pipefail
    python3 test/capacity_check_test.py
    python3 -O test/capacity_check_test.py
    evidence="$(mktemp -d "$PWD/_build/capacity-XXXXXX")"
    for sessions in 1 10 100 1000; do
      python3 tools/capacity_check.py --binary "$PWD/_build/default/test/capacity_main.exe" --sessions "$sessions" --out "$evidence/$sessions" > "$evidence/$sessions.json"
    done
    printf '%s\n' "$evidence"

release-tools: conformance-env
    python3 test/release_process_test.py -v
    python3 -O test/release_process_test.py -v
    python3 test/release_materialize_test.py -v
    PYTHONOPTIMIZE=1 python3 test/release_materialize_test.py -v
    python3 test/release_check_test.py -v
    python3 -O test/release_check_test.py -v
    python3 test/release_fuzz_test.py -v
    python3 -O test/release_fuzz_test.py -v

fuzz: build
    opam exec --switch . -- dune exec fuzz/boundaries.exe -- --repeat 10000 --seed 20260930

conformance: build
    #!/usr/bin/env bash
    set -euo pipefail
    python3 -m unittest discover -s ../conformance/tests -v
    python3 -O -m unittest discover -s ../conformance/tests -v
    evidence="$(mktemp -d "$PWD/_build/conformance-XXXXXX")"
    python3 ../conformance/tests/acceptance.py --candidate "$PWD/_build/default/bin/main.exe" --out "$evidence/normal"
    python3 -O ../conformance/tests/acceptance.py --candidate "$PWD/_build/default/bin/main.exe" --out "$evidence/optimized"
    printf '%s\n' "$evidence"
