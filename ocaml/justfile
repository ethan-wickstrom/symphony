build:
    opam exec --switch . -- dune build @all @test/native-http-inputs

test: build
    opam exec --switch . -- dune runtest
    python3 test/native_check_test.py
    PYTHONOPTIMIZE=1 python3 test/native_check_test.py
    python3 test/native_check.py --kernel _build/default/test/native_kernel/test_main.exe --host _build/default/test/native_host/test_main.exe --http _build/default/test/native_http_test.exe --agent _build/default/test/native_agent_test.exe --out _build/native-evidence
    PYTHONOPTIMIZE=1 python3 test/native_check.py --kernel _build/default/test/native_kernel/test_main.exe --host _build/default/test/native_host/test_main.exe --http _build/default/test/native_http_test.exe --agent _build/default/test/native_agent_test.exe --out _build/native-evidence-optimized
    python3 test/cli_check.py _build/default/bin/main.exe
    PYTHONOPTIMIZE=1 python3 test/cli_check.py _build/default/bin/main.exe
    python3 test/tracker_cli_check.py _build/default/bin/main.exe
    PYTHONOPTIMIZE=1 python3 test/tracker_cli_check.py _build/default/bin/main.exe

format:
    opam exec --switch . -- dune fmt

check-format:
    opam exec --switch . -- dune build @fmt

check: test check-format
    just capacity
    just protocol-codec
    opam exec --switch . -- python3 test/lifecycle_types_test.py
    opam exec --switch . -- python3 -O test/lifecycle_types_test.py
    opam exec --switch . -- dune exec tools/check_source.exe -- .
    opam exec --switch . -- dune exec tools/check_source.exe -- --self-test
    python3 tools/check_protocol.py .
    PYTHONOPTIMIZE=1 python3 tools/check_protocol.py .
    python3 test/verification_check.py .
    python3 tools/check_h1.py ../vendor/h1
    PYTHONOPTIMIZE=1 python3 tools/check_h1.py ../vendor/h1
    just release-tools

protocol-codec: build
    python3 -m venv _build/codec-venv
    _build/codec-venv/bin/python -m pip install --require-hashes --only-binary=:all: --no-cache-dir --disable-pip-version-check -r tools/protocol_codec_requirements.lock
    opam exec --switch . -- dune exec test/protocol_fixtures.exe > _build/codec-fixtures.jsonl
    _build/codec-venv/bin/python tools/protocol_codec_check.py _build/codec-fixtures.jsonl --exporter _build/default/test/protocol_fixtures.exe --evidence-dir _build/codec-evidence/normal
    _build/codec-venv/bin/python -O tools/protocol_codec_check.py _build/codec-fixtures.jsonl --exporter _build/default/test/protocol_fixtures.exe --evidence-dir _build/codec-evidence/optimized

capacity: build
    #!/usr/bin/env bash
    set -euo pipefail
    python3 test/capacity_check_test.py
    python3 -O test/capacity_check_test.py
    evidence="$(mktemp -d "$PWD/_build/capacity-XXXXXX")"
    for sessions in 1 10 100 1000; do
      python3 tools/capacity_check.py --binary "$PWD/_build/default/test/capacity_main.exe" --sessions "$sessions" --out "$evidence/$sessions" > "$evidence/$sessions.json"
    done
    printf '%s\n' "$evidence"

release-tools:
    python3 test/release_process_test.py -v
    python3 -O test/release_process_test.py -v
    python3 test/release_materialize_test.py -v
    PYTHONOPTIMIZE=1 python3 test/release_materialize_test.py -v
    python3 test/release_check_test.py -v
    python3 -O test/release_check_test.py -v
    python3 test/release_fuzz_test.py -v
    python3 -O test/release_fuzz_test.py -v

fuzz: build
    opam exec --switch . -- dune exec fuzz/boundaries.exe -- --repeat 10000 --seed 20260930
